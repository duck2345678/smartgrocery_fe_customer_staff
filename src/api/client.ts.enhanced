import axios, { AxiosError, AxiosResponse, InternalAxiosRequestConfig } from 'axios';
import { useAuthStore } from '../store/authStore';

/**
 * API Client Configuration
 *
 * This module handles:
 * - Base URL configuration from environment variables
 * - Token management and refresh logic
 * - Request/response interceptors
 * - Error handling
 * - Request timing in development
 */

const BASE_URL = process.env.EXPO_PUBLIC_API_URL ?? 'http://10.0.2.2:8080/api/v1';
const API_TIMEOUT = Number(process.env.EXPO_PUBLIC_API_TIMEOUT) || 15000;

/**
 * API Response envelope format
 * All API responses follow this structure
 */
type ApiEnvelope<T> = {
  data: T;
  message?: string;
  status?: string | number;
  success?: boolean;
};

/**
 * Request config with metadata for tracking
 */
type RetriableRequestConfig = InternalAxiosRequestConfig & {
  _retry?: boolean;
  _meta?: { startAt: number };
};

/**
 * Unwrap API response envelope to get data
 * If response doesn't have envelope, returns as-is
 */
const unwrap = <T>(value: unknown): T => {
  if (value && typeof value === 'object' && 'data' in value) {
    return (value as ApiEnvelope<T>).data;
  }
  return value as T;
};

/**
 * Extract error message from response
 * Tries to find meaningful error message in nested response
 */
const extractMessage = (data: unknown): string | null => {
  if (typeof data === 'string' && data.trim()) return data.trim();
  if (!data || typeof data !== 'object') return null;
  if ('message' in data && typeof (data as { message?: unknown }).message === 'string') {
    return (data as { message: string }).message;
  }
  if ('data' in data) return extractMessage((data as { data?: unknown }).data);
  return null;
};

/**
 * Create axios instance with base configuration
 */
const apiClient = axios.create({
  baseURL: BASE_URL,
  timeout: API_TIMEOUT,
  headers: {
    'Content-Type': 'application/json',
  },
});

/**
 * Token refresh queue for handling concurrent requests during token refresh
 * Prevents multiple simultaneous refresh requests
 */
let isRefreshing = false;
let refreshQueue: Array<{ resolve: (token: string) => void; reject: (err: unknown) => void }> = [];

/**
 * Process queued requests after token refresh
 * Either fulfills with new token or rejects with error
 */
const flushQueue = (err: unknown | null, token?: string) => {
  const queued = refreshQueue;
  refreshQueue = [];
  queued.forEach((p) => {
    if (err || !token) p.reject(err ?? new Error('Phiên đăng nhập hết hạn'));
    else p.resolve(token);
  });
};

/**
 * Refresh access token using refresh token
 * Called when API returns 401 (Unauthorized)
 *
 * @throws Error if refresh token is missing or refresh fails
 */
const refreshAccessToken = async (): Promise<string> => {
  const refreshToken = useAuthStore.getState().refreshToken;
  if (!refreshToken) throw new Error('Phiên đăng nhập hết hạn');

  const response = await axios.post(`${BASE_URL}/auth/refresh`, { refreshToken });
  const tokens = unwrap<{ token: string; refreshToken: string }>(response.data);
  useAuthStore.getState().setTokens(tokens.token, tokens.refreshToken);
  return tokens.token;
};

/**
 * REQUEST INTERCEPTOR
 * Adds authorization token to all requests
 * Tracks request timing for performance monitoring
 */
apiClient.interceptors.request.use(async (config) => {
  // Track request start time for performance monitoring
  const startAt =
    typeof globalThis !== 'undefined' &&
    'performance' in globalThis &&
    typeof (globalThis as { performance?: { now?: () => number } }).performance?.now === 'function'
      ? (globalThis as { performance: { now: () => number } }).performance.now()
      : Date.now();
  (config as RetriableRequestConfig)._meta = { startAt };

  // Add bearer token if available
  const token = useAuthStore.getState().token;
  if (token) {
    config.headers = config.headers ?? {};
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

/**
 * RESPONSE INTERCEPTOR
 * Handles successful responses and all error cases
 *
 * Success: Unwraps API envelope and logs timing in dev
 * 5xx Errors: Generic "server error" message
 * 401 Errors: Refresh token with retry logic
 * 4xx Errors: Return error message to caller
 * Network Errors: Provide network-specific error message
 */
apiClient.interceptors.response.use(
  (response: AxiosResponse) => {
    const cfg = response.config as RetriableRequestConfig;
    
    // Log request timing in development
    if (typeof __DEV__ !== 'undefined' && __DEV__ && cfg._meta?.startAt != null) {
      const endAt =
        typeof globalThis !== 'undefined' &&
        'performance' in globalThis &&
        typeof (globalThis as { performance?: { now?: () => number } }).performance?.now === 'function'
          ? (globalThis as { performance: { now: () => number } }).performance.now()
          : Date.now();
      const ms = Math.round(endAt - cfg._meta.startAt);
      const method = String(cfg.method ?? 'GET').toUpperCase();
      const url = cfg.url ?? '';
      console.log(`[NET OK] ${method} ${url} ${ms}ms`);
    }

    // Unwrap API envelope
    const payload = response.data;
    if (payload && typeof payload === 'object' && 'data' in payload) {
      response.data = (payload as ApiEnvelope<unknown>).data;
    }
    return response;
  },
  async (error: AxiosError) => {
    const originalRequest = (error.config ?? {}) as RetriableRequestConfig;
    
    // Log error timing in development
    if (typeof __DEV__ !== 'undefined' && __DEV__ && originalRequest._meta?.startAt != null) {
      const endAt =
        typeof globalThis !== 'undefined' &&
        'performance' in globalThis &&
        typeof (globalThis as { performance?: { now?: () => number } }).performance?.now === 'function'
          ? (globalThis as { performance: { now: () => number } }).performance.now()
          : Date.now();
      const ms = Math.round(endAt - originalRequest._meta.startAt);
      const method = String(originalRequest.method ?? 'GET').toUpperCase();
      const url = originalRequest.url ?? '';
      const st = error.response?.status ?? 0;
      console.log(`[NET ERR] ${method} ${url} ${st} ${ms}ms`);
    }

    // Handle network errors (no response from server)
    if (!error.response) {
      const message =
        error.code === 'ECONNABORTED'
          ? 'Kết nối đến máy chủ bị quá thời gian. Vui lòng kiểm tra IP/Port hoặc mạng.'
          : 'Không thể kết nối đến máy chủ. Vui lòng kiểm tra IP/Port hoặc mạng.';
      const apiError = new Error(message) as Error & { status?: number };
      apiError.status = 0;
      return Promise.reject(apiError);
    }

    // Handle 401 (Unauthorized) - Try to refresh token
    if (error.response?.status === 401 && !originalRequest._retry) {
      // If already refreshing, queue this request
      if (isRefreshing) {
        return new Promise((resolve, reject) => {
          refreshQueue.push({
            resolve: (token) => resolve(apiClient({ 
              ...originalRequest, 
              headers: { ...originalRequest.headers, Authorization: `Bearer ${token}` } 
            })),
            reject,
          });
        });
      }

      // Start token refresh
      originalRequest._retry = true;
      isRefreshing = true;

      try {
        const newToken = await refreshAccessToken();
        isRefreshing = false;
        flushQueue(null, newToken);

        // Retry original request with new token
        originalRequest.headers = originalRequest.headers ?? {};
        originalRequest.headers.Authorization = `Bearer ${newToken}`;
        return apiClient(originalRequest);
      } catch (e) {
        // Token refresh failed
        isRefreshing = false;
        flushQueue(e);
        useAuthStore.getState().logout();
        return Promise.reject(e);
      }
    }

    // Extract meaningful error message
    const status = error.response?.status;
    const reqInfo = originalRequest?.url ? ` (${String(originalRequest.method ?? 'GET').toUpperCase()} ${originalRequest.url})` : '';
    const message =
      extractMessage(error.response?.data) ??
      (typeof status === 'number' && status >= 500
        ? `Máy chủ đang gặp lỗi. Vui lòng thử lại sau.${reqInfo}`
        : 'Đã có lỗi xảy ra');
    
    const apiError = new Error(message) as Error & { status?: number };
    apiError.status = status;
    return Promise.reject(apiError);
  }
);

export default apiClient;
