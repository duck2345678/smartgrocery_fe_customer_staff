# =========================================================================
# SmartGrocery Mobile App Configuration Template (.env.example)
# Hướng dẫn: Sao chép tệp này thành '.env' và điền IP máy chạy backend thực tế.
# =========================================================================

# LƯU Ý: Khi kết nối từ điện thoại thật, KHÔNG dùng localhost hoặc 127.0.0.1.
# Hãy dùng IP Wi-Fi cục bộ của máy tính đang chạy backend (Ví dụ: 192.168.1.15)
EXPO_PUBLIC_API_URL=http://your-computer-local-ip-address:8080/api/v1
