{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "app",
    "src/api",
    "src/store",
    "src/styles",
    "src/types",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/assets"
  ]
}
