{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ESNext"]
  },
  "include": [
    "app",
    "src",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/App.tsx",
    "src/main.tsx",
    "src/assets"
  ]
}
